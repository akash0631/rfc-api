<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!-- /api/rfc/proxy strict parameter mode.
         true  = refuse to invoke the RFC when any input parameter could not be applied
                 (HTTP 400 + _PARAM_ERRORS, instead of running on a partial payload).
         false = legacy behaviour: record the failure and execute anyway.
         Shipped as false so this deploy is behaviour-identical for every existing caller.
         Flip to true once no live consumer is seen tripping _PARAM_ERRORS — editing this
         file is enough, no redeploy. Per-call override: ?strict=1 / ?strict=0.
         The stale-metadata self-heal runs regardless of this setting. -->
    <add key="RfcProxy.StrictParams" value="false" />
    <!-- /api/rfc/proxy Java-MW table compatibility.
         true  = prepend a field-label row to every table, as the legacy Java middleware
                 on 192.168.144.200 does. The HHT Android app has 38 loops written
                 `for (int i = 1; ...)` to step over that row, so without it the app
                 discards the first REAL data row of every table — a five-item stock take
                 shows four. True of dev and qa since 2026-05-04.
         false = data rows only (what this proxy has always returned).
         Shipped as false: every existing consumer expects data rows only and must not
         change under them. Turn on for HHT traffic per call with ?labelrow=1, or globally
         here once no non-HHT consumer is left. Web.config edit is enough, no redeploy. -->
    <add key="RfcProxy.LabelRow" value="false" />
