<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to secrets.config NEXT TO Web.config on the IIS host
  (C:\V2RfcTest\secrets.config) and fill in the real values.

  secrets.config is gitignored and is NOT deployed by deploy-iis.yml, so it
  survives every deploy. Web.config is force-copied from the repo on each
  deploy, which is exactly why tokens must not be written into Web.config.

  This repo is PUBLIC. Never commit a real token.

  ── The faster route: machine environment variables ────────────────────
  This file only takes effect once Web.config carries appSettings
  file="secrets.config", and that line reaches the host only on a deploy.
  ReadSetting checks appSettings first and then falls back to the Machine
  environment target, so setting these as machine environment variables
  works immediately, needs no deploy, and cannot be clobbered by
  deploy-iis.yml. V2RfcTestPool runs as LocalSystem and reads them fine.

    C:\Users\akash.agarwal\bin\townkart-setup.ps1 -Apply

  does exactly that, reading the values out of Townkart's own Postman
  collection so nobody retypes a 320-character JWT. IIS caches machine
  environment variables at worker start, so the pool must be recycled
  after — the script does it.

  ── Townkart V2 (Unthinkable), issued by Townkart ──────────────────────
  Their two endpoints do NOT share a credential. Their Postman collection
  is the authority:

    sku-inventory            X-Api-Key + X-Api-Token, no Authorization
    sync-inventory-from-sap  Authorization: Bearer + a context_shopId
                             cookie, and neither X-Api-* header

  Sending the inventory token to the sync endpoint returns 401, which is
  indistinguishable from an expired token — so keep them separate.

  Expiries as at 2026-08-21 (decoded from the JWT exp claim):
    TOWNKART_TOKEN       2026-09-09 18:48
    TOWNKART_SYNC_TOKEN  2026-09-23 18:44
  A scheduled push dies with HTTP 401 the moment the first one lapses.
  Renew before that date, or get a long-lived service credential
  (spec open point O5).
-->
<appSettings>
  <!-- Inventory push: /api/v2/store/sku-inventory -->
  <add key="TOWNKART_API_KEY" value="" />      <!-- X-Api-Key,   opaque, 43 chars -->
  <add key="TOWNKART_TOKEN" value="" />        <!-- X-Api-Token, JWT,   320 chars -->

  <!-- Sync call: /api/custom/inventory/Inventory/sync-inventory-from-sap.
       Only needed when a push is run with &sync=true. Spec O7 has not
       confirmed the call is required at all, so it stays opt-in. -->
  <add key="TOWNKART_SYNC_TOKEN" value="" />   <!-- Authorization bearer, JWT -->
  <add key="TOWNKART_SYNC_COOKIE" value="" />  <!-- context_shopId=... -->

  <!-- Optional. Zero-quantity handling, spec 8.3 / vendor question Q1.
       send (default) = sold-out SKUs go as quantity 0
       skip           = sold-out SKUs are omitted entirely
       TOWNKART_ZERO_ADJUSTMENT overrides adjustmentType on qty 0 rows only.
       Both are also query parameters, so they can be tried per run. -->
  <!-- <add key="TOWNKART_ZERO_MODE" value="send" /> -->
  <!-- <add key="TOWNKART_ZERO_ADJUSTMENT" value="REPLACE" /> -->

  <!-- Optional. Where the delta watermark lives. Must be OUTSIDE the site
       root, which is build output. Defaults to C:\V2RfcState. -->
  <!-- <add key="TOWNKART_STATE_DIR" value="C:\V2RfcState" /> -->
</appSettings>
